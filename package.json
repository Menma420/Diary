{
  "name": "dear-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --conditions=react-server scripts/auth/run-e2e.mjs",
    "test:auth": "node --conditions=react-server --test tests/auth/database.test.mjs",
    "env:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-env.ts",
    "tokens:generate": "node scripts/theme-css.mjs --write",
    "tokens:check": "node scripts/theme-css.mjs",
    "check:client": "node scripts/check-client-output.mjs",
    "neon:check": "node scripts/check-neon.mjs",
    "test:diary": "node --conditions=react-server --test tests/diary/database.test.mjs"
  },
  "dependencies": {
    "@neon/config": "1.10.0",
    "@neon/env": "1.6.8",
    "@vercel/functions": "3.10.5",
    "better-auth": "1.7.15",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
