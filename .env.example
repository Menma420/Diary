# Server configuration only. No NEXT_PUBLIC_* variables or administration keys.
APP_ORIGIN=http://127.0.0.1:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# Neon setup: `neon deploy` pulls these into the ignored .env.local.
# Use the pooled URL for the app; reserve the unpooled URL for future migrations.
# DATABASE_URL=postgresql://user:password@your-endpoint-pooler.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require
# NEON_BRANCH=production

# Phase 5: separate least-privileged auth connection; no DATABASE_URL fallback.
# Leave absent until auth-only migrations and real owner provisioning are approved.
# AUTH_DATABASE_URL=postgresql://runtime:password@your-endpoint-pooler.neon.tech/neondb?sslmode=verify-full
# BETTER_AUTH_SECRET=<cryptographically-random-at-least-32-characters>
# Independent stable root: canonical base64url of 32 cryptographically random bytes.
# AUTH_DERIVATION_SECRET=<43-character-base64url-secret>
# Do not reuse the signing secret. Rotation requires the documented maintenance window.
# AUTH_MAIL_MODE=unconfigured
# AUTH_MAIL_MODE=brevo requires a verified sender and server-only API key:
# BREVO_API_KEY=<transactional-email-api-key>
# AUTH_MAIL_FROM=<verified-sender-email>
# AUTH_MAIL_MODE=sink is restricted to wholly loopback test environments.
# AUTH_MAIL_SINK_URL=http://127.0.0.1:<test-sink-port>
