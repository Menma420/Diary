# Server configuration only. No NEXT_PUBLIC_* variables or administration keys.
APP_ORIGIN=http://127.0.0.1:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# Neon setup: `neon deploy` pulls these into the ignored .env.local.
# Use the pooled URL for the app; reserve the unpooled URL for future migrations.
# DATABASE_URL=postgresql://user:password@your-endpoint-pooler.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require
# NEON_BRANCH=production

# Required together when authentication/database integration begins in Phase 5.
# Leave absent for Phase 1; do not invent credentials to make a build pass.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# OWNER_USER_ID=your-provisioned-owner-uuid
